# Copy this file to .env locally if you want, but never commit .env.
#
# Option 1: Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Vertex AI / Google Cloud Application Default Credentials
# Set this to true when using the Google Gen AI SDK / Vertex AI style config:
GOOGLE_GENAI_USE_VERTEXAI=true
#
# Run this locally instead of storing credentials in the repository:
# gcloud auth application-default login
#
# Optional runtime settings:
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
